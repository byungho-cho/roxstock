{
  "name": "roxstock-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/domain/*.test.ts src/collector/*.test.ts",
    "collector": "tsx src/collector/worker.ts daemon",
    "collector:once:prices": "tsx src/collector/worker.ts prices",
    "collector:once:snapshots": "tsx src/collector/worker.ts snapshots",
    "collector:once": "tsx src/collector/worker.ts all",
    "prisma:format": "prisma format --schema ../database/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema ../database/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema ../database/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema ../database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema ../database/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "dotenv": "17.4.2",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
