NODE_ENV=development
HOST=0.0.0.0
PORT=3300
DATABASE_URL="mysql://roxstock:change-me@localhost:3306/roxstock"

# Destructive test-only endpoint: POST /api/accounts/:accountId/reset
# Keep false in production. The API also requires confirmation="초기화".
ENABLE_ACCOUNT_DATA_RESET=false

# Collector (all schedules are evaluated in Asia/Seoul)
COLLECTOR_PRICE_PROVIDER=naver
COLLECTOR_PROVIDER_DELAY_MS=1000
COLLECTOR_REQUEST_TIMEOUT_MS=10000
COLLECTOR_PRICE_COLLECTION_HOUR=20
COLLECTOR_PRICE_RETRY_DELAY_MINUTES=60
COLLECTOR_SNAPSHOT_HOURS=23
COLLECTOR_LOCK_TTL_SECONDS=7200
COLLECTOR_SCHEDULER_TICK_SECONDS=30

# Selected HOLDING/WATCHLIST/RECOMMENDED prices during NXT/KRX trading sessions
COLLECTOR_REALTIME_ENABLED=true
COLLECTOR_REALTIME_INTERVAL_SECONDS=60
COLLECTOR_REALTIME_DB_FLUSH_SECONDS=60
COLLECTOR_REALTIME_TARGET_REFRESH_SECONDS=30
COLLECTOR_REALTIME_STALE_BACKOFF_SECONDS=300
COLLECTOR_REALTIME_MAX_SECURITIES=100
COLLECTOR_REALTIME_CONCURRENCY=5
COLLECTOR_REALTIME_PRE_MARKET_OPEN=08:00
COLLECTOR_REALTIME_PRE_MARKET_CLOSE=08:50
COLLECTOR_REALTIME_REGULAR_MARKET_OPEN=09:00
COLLECTOR_REALTIME_REGULAR_MARKET_CLOSE=15:30
COLLECTOR_REALTIME_AFTER_MARKET_OPEN=15:40
COLLECTOR_REALTIME_AFTER_MARKET_CLOSE=20:00
COLLECTOR_REALTIME_API_URL=http://localhost:3300/internal/realtime-prices
# Generate a long random value separately for every environment. Never commit the real value.
COLLECTOR_INTERNAL_TOKEN=change-me

# Open DART financial statements. Keep DART_API_KEY secret and never commit it.
DART_API_KEY=
DART_COLLECTOR_ENABLED=true
DART_DAILY_CALL_LIMIT=3000
DART_MIN_DELAY_MS=5000
# Initial history only. Shared with manual requests; stop on DART 020.
DART_BACKFILL_DAILY_CALL_LIMIT=10000
DART_BACKFILL_MIN_DELAY_MS=2000
DART_REST_DAY_ALL_DAY=true
# Optional verified YYYY-MM-DD dates if official holiday service is unavailable.
DART_PUBLIC_HOLIDAYS=
DART_BACKFILL_START_YEAR=2015
DART_BACKFILL_COMPANY_LIMIT=250
DART_UNIVERSE_DAILY_COMPANIES=35
DART_NIGHT_WINDOW_START_HOUR=18
DART_NIGHT_WINDOW_END_HOUR=6
DART_CORP_CODE_REFRESH_HOURS=24

# KOSPI/KOSDAQ security master (public Data Portal decoding key)
DATA_GO_KR_SERVICE_KEY=change-me
DATA_GO_KR_KRX_LISTED_ENDPOINT=https://apis.data.go.kr/1160100/GetKrxListedInfoService_V2/getItemInfo_V2
COLLECTOR_SECURITY_MASTER_HOUR=7
COLLECTOR_SECURITY_MASTER_PAGE_SIZE=1000
COLLECTOR_SECURITY_MASTER_LOOKBACK_DAYS=14
COLLECTOR_SECURITY_MASTER_MINIMUM_COUNT=2000
# Enable only after confirming the source returns a complete market snapshot.
COLLECTOR_SECURITY_MASTER_DEACTIVATE_MISSING=false

# Server only. Register independently in backend/.env.production on the server.
KRX_API_KEY=
# Expand only after live Samsung price/share-basis verification. Applies to KRX/consensus, not DART.
KRX_VALIDATED_SYMBOLS=005930
# Licensed annual consensus adapter; disabled until provider terms and actual responses are verified.
CONSENSUS_ENABLED=false
CONSENSUS_PROVIDER_URL=
CONSENSUS_API_KEY=
CONSENSUS_TERMS_APPROVED=false
CONSENSUS_TERMS_URL=

