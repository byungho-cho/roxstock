NODE_ENV=development
HOST=0.0.0.0
PORT=3300
DATABASE_URL="mysql://roxstock:change-me@localhost:3306/roxstock"
ENABLE_ACCOUNT_DATA_RESET=false
# Shared secret for collector -> API realtime notifications; keep identical in both processes.
COLLECTOR_INTERNAL_TOKEN=change-me
# Monitoring/manual request policy is shared with collector. Same values in both processes.
DART_DAILY_CALL_LIMIT=3000
DART_BACKFILL_DAILY_CALL_LIMIT=10000
DART_REST_DAY_ALL_DAY=true
DART_PUBLIC_HOLIDAYS=
# Optional public release metadata, used in production to avoid unrelated service redeploys.
# ROXSTOCK_RELEASE_FILE=/run/roxstock/release.json
# Collector-specific options and keys: ../collector/.env.example
