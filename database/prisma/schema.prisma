generator client {
  provider = "prisma-client-js"
  output   = "../../shared/src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Additive v1.1 storage: source observations are independent of account history.
model InvestorFlowDaily {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  targetType String @map("target_type") @db.VarChar(12)
  targetKey String @map("target_key") @db.VarChar(20)
  tradeDate DateTime @map("trade_date") @db.Date
  investorCode String @map("investor_code") @db.VarChar(32)
  investorName String @map("investor_name") @db.VarChar(64)
  source String @db.VarChar(32)
  exchangeScope String @map("exchange_scope") @db.VarChar(24)
  buyAmount Decimal? @map("buy_amount") @db.Decimal(32,4)
  sellAmount Decimal? @map("sell_amount") @db.Decimal(32,4)
  netAmount Decimal? @map("net_amount") @db.Decimal(32,4)
  buyQuantity Decimal? @map("buy_quantity") @db.Decimal(32,4)
  sellQuantity Decimal? @map("sell_quantity") @db.Decimal(32,4)
  netQuantity Decimal? @map("net_quantity") @db.Decimal(32,4)
  amountUnit String? @map("amount_unit") @db.VarChar(24)
  quantityUnit String? @map("quantity_unit") @db.VarChar(24)
  publicationStatus String @map("publication_status") @db.VarChar(24)
  reason String? @db.VarChar(500)
  raw Json
  collectedAt DateTime @default(now()) @map("collected_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  @@unique([targetType,targetKey,tradeDate,source,exchangeScope,investorCode],map:"investor_flow_identity")
  @@index([targetType,targetKey,tradeDate])
  @@map("investor_flow_daily")
}

enum MarketType {
  KOSPI
  KOSDAQ
  KONEX
  OTHER
}

enum SecurityType {
  STOCK
  ETF
  ETN
  REIT
  OTHER
}

enum WatchlistType {
  WATCHLIST
  HOLDING
  RECOMMENDED
}

enum CashTransactionType {
  BUY
  SELL
  DEPOSIT
  WITHDRAWAL
  DIVIDEND
}

enum FinancialPeriodType {
  ANNUAL
  Q1
  Q2
  Q3
  Q4
}

enum CollectorRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
  SKIPPED
}

enum CollectorItemStatus {
  SUCCESS
  FAILED
  STALE
  SKIPPED
  NO_DATA
  NOT_APPLICABLE
}

enum DartTaskStatus {
  PENDING
  PROCESSING
  SUCCESS
  NO_FILING
  NOT_APPLICABLE
  FAILED
}

model Account {
  id                      BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  name                    String                  @db.VarChar(100)
  brokerName              String                  @map("broker_name") @db.VarChar(100)
  accountNumber           String?                 @map("account_number") @db.VarChar(50)
  normalizedAccountNumber String?                 @map("normalized_account_number") @db.VarChar(50)
  cashBalance             Decimal                 @default(0) @map("cash_balance") @db.Decimal(19, 4)
  isActive                Boolean                 @default(true) @map("is_active")
  isDefault               Boolean                 @default(false) @map("is_default")
  displayOrder            Int                     @default(0) @map("display_order") @db.UnsignedSmallInt
  createdAt               DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  targetArrivalConditions Json?                   @map("target_arrival_conditions")
  targetArrivalVersion    Int                     @default(0) @map("target_arrival_version") @db.UnsignedInt
  profitRevision          AccountProfitRevision?
  profitAggregates        InvestmentYearAggregate[]
  buyTrades               BuyTrade[]
  watchlistItems          AccountWatchlistItem[]
  tradeRequests           TradeRequest[]
  cashTransactions        CashTransaction[]
  dividends               Dividend[]
  dailyAccountSnapshots   DailyAccountSnapshot[]
  dailyPositionSnapshots  DailyPositionSnapshot[]
  compoundGrowthPlans     CompoundGrowthPlan[]

  @@unique([brokerName, normalizedAccountNumber])
  @@index([isActive, isDefault])
  @@map("accounts")
}

model Security {
  id                     BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  symbol                 String                  @db.VarChar(20) @unique
  registrationSource     String                  @default("UNKNOWN") @map("registration_source") @db.VarChar(20)
  collectionExcluded     Boolean                 @default(false) @map("collection_excluded")
  excludedFeatures       Json?                   @map("excluded_features")
  collectionRevision     Int                     @default(0) @map("collection_revision")
  codeRevision           Int                     @default(0) @map("code_revision")
  codeChangedAt          DateTime?               @map("code_changed_at") @db.DateTime(3)
  codeHistory            SecurityCodeHistory[]
  name                   String                  @db.VarChar(100)
  marketType             MarketType              @map("market_type")
  listingYear            Int?                    @map("listing_year") @db.UnsignedSmallInt
  securityType           SecurityType            @default(STOCK) @map("security_type")
  isActive               Boolean                 @default(true) @map("is_active")
  createdAt              DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  newsItems              StockNewsSecurity[]
  watchlistItem          WatchlistItem?
  accountWatchlistItems  AccountWatchlistItem[]
  buyTrades              BuyTrade[]
  dividends              Dividend[]
  marketPrice            MarketPrice?
  dailyPositionSnapshots DailyPositionSnapshot[]
  financialStatements    FinancialStatement[]
  valuationMetrics       ValuationMetric[]
  periodValuations       PeriodValuation[]
  annualConsensusSnapshots AnnualConsensusSnapshot[]
  fundamentals           SecurityFundamentals?
  collectorRunItems      CollectorRunItem[]
  dartCorpMapping        DartCorpMapping?
  dartSecurityState      DartSecurityState?
  dartBackfillTasks      DartBackfillTask[]
  dartFinancialFilings   DartFinancialFiling[]
  dartShareSnapshots     DartShareSnapshot[]
  fundamentalSnapshots FundamentalSnapshot[]
  dartDailyCompanyChecks DartDailyCompanyCheck[]

  @@unique([marketType, symbol])
  @@map("securities")
}

model CollectorLock {
  jobName     String   @id @map("job_name") @db.VarChar(100)
  ownerToken  String   @map("owner_token") @db.VarChar(64)
  lockedUntil DateTime @map("locked_until") @db.DateTime(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("collector_locks")
}

model CollectorRun {
  id            BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  jobType       String             @map("job_type") @db.VarChar(100)
  provider      String             @db.VarChar(100)
  status        CollectorRunStatus @default(RUNNING)
  startedAt     DateTime           @default(now()) @map("started_at") @db.DateTime(3)
  finishedAt    DateTime?          @map("finished_at") @db.DateTime(3)
  successCount  Int                @default(0) @map("success_count") @db.UnsignedInt
  failureCount  Int                @default(0) @map("failure_count") @db.UnsignedInt
  staleCount    Int                @default(0) @map("stale_count") @db.UnsignedInt
  skippedCount  Int                @default(0) @map("skipped_count") @db.UnsignedInt
  failureReason String?            @map("failure_reason") @db.VarChar(1000)
  metadata      Json?
  items         CollectorRunItem[]

  @@index([jobType, startedAt])
  @@index([finishedAt, id], map: "collector_runs_finished_scan_idx")
  @@map("collector_runs")
}

model CollectorRunItem {
  diagnostics Json?
  id         BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  runId      BigInt              @map("run_id") @db.UnsignedBigInt
  securityId BigInt?             @map("security_id") @db.UnsignedBigInt
  symbol     String              @db.VarChar(100)
  status     CollectorItemStatus
  message    String?             @db.VarChar(1000)
  observedAt DateTime?           @map("observed_at") @db.DateTime(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  run        CollectorRun        @relation(fields: [runId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  security   Security?           @relation(fields: [securityId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([runId, status])
  @@index([status,createdAt,id], map: "collector_items_created_scan_idx")
  @@index([status,observedAt,id], map: "collector_items_observed_scan_idx")
  @@index([securityId])
  @@map("collector_run_items")
}

model RealtimeWorkerState {
  id                    String   @id @default("selected-prices") @db.VarChar(40)
  workerToken           String?  @map("worker_token") @db.VarChar(64)
  workerStatus          String   @default("STOPPED") @map("worker_status") @db.VarChar(20)
  startedAt             DateTime? @map("started_at") @db.DateTime(3)
  heartbeatAt           DateTime? @map("heartbeat_at") @db.DateTime(3)
  marketSession         String   @default("OUT_OF_SESSION") @map("market_session") @db.VarChar(20)
  lastCycleStartedAt    DateTime? @map("last_cycle_started_at") @db.DateTime(3)
  lastCycleFinishedAt   DateTime? @map("last_cycle_finished_at") @db.DateTime(3)
  targetCount           Int      @default(0) @map("target_count") @db.UnsignedInt
  receivedCount         Int      @default(0) @map("received_count") @db.UnsignedInt
  sourceFailureCount    Int      @default(0) @map("source_failure_count") @db.UnsignedInt
  staleCount            Int      @default(0) @map("stale_count") @db.UnsignedInt
  publishedCount        Int      @default(0) @map("published_count") @db.UnsignedInt
  publishFailureCount   Int      @default(0) @map("publish_failure_count") @db.UnsignedInt
  savedCount            Int      @default(0) @map("saved_count") @db.UnsignedInt
  saveFailureCount      Int      @default(0) @map("save_failure_count") @db.UnsignedInt
  lastPriceReceivedAt   DateTime? @map("last_price_received_at") @db.DateTime(3)
  lastSourcePriceAt     DateTime? @map("last_source_price_at") @db.DateTime(3)
  lastSsePublishedAt    DateTime? @map("last_sse_published_at") @db.DateTime(3)
  lastDbSavedAt         DateTime? @map("last_db_saved_at") @db.DateTime(3)
  lastSourceError       String?  @map("last_source_error") @db.VarChar(1000)
  lastPublishError      String?  @map("last_publish_error") @db.VarChar(1000)
  lastSaveError         String?  @map("last_save_error") @db.VarChar(1000)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("realtime_worker_state")
}

model RealtimeCycleAggregate {
  minuteStartedAt   DateTime @id @map("minute_started_at") @db.DateTime(3)
  cycleCount        Int      @default(0) @map("cycle_count") @db.UnsignedInt
  targetCount       Int      @default(0) @map("target_count") @db.UnsignedInt
  receivedCount     Int      @default(0) @map("received_count") @db.UnsignedInt
  sourceFailureCount Int     @default(0) @map("source_failure_count") @db.UnsignedInt
  staleCount        Int      @default(0) @map("stale_count") @db.UnsignedInt
  publishedCount    Int      @default(0) @map("published_count") @db.UnsignedInt
  publishFailureCount Int    @default(0) @map("publish_failure_count") @db.UnsignedInt
  savedCount        Int      @default(0) @map("saved_count") @db.UnsignedInt
  saveFailureCount  Int      @default(0) @map("save_failure_count") @db.UnsignedInt
  lastCycleFinishedAt DateTime? @map("last_cycle_finished_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([updatedAt])
  @@map("realtime_cycle_aggregates")
}

model RealtimeCollectorIssue {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  occurredAt DateTime @default(now()) @map("occurred_at") @db.DateTime(3)
  stage      String   @db.VarChar(20)
  symbol     String?  @db.VarChar(20)
  message    String   @db.VarChar(1000)

  @@index([occurredAt])
  @@index([stage, occurredAt])
  @@map("realtime_collector_issues")
}

model DartCorpMapping {
  collectionSymbol String? @map("collection_symbol") @db.VarChar(20)
  securityId       BigInt   @id @map("security_id") @db.UnsignedBigInt
  corpCode         String   @unique @map("corp_code") @db.Char(8)
  stockCode        String   @unique @map("stock_code") @db.Char(6)
  corpName         String   @map("corp_name") @db.VarChar(200)
  sourceModifiedAt String?  @map("source_modified_at") @db.Char(8)
  syncedAt         DateTime @map("synced_at") @db.DateTime(3)
  security         Security @relation(fields: [securityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([stockCode])
  @@map("dart_corp_mappings")
}

model DartSecurityState {
  securityId              BigInt    @id @map("security_id") @db.UnsignedBigInt
  backfillStartedAt       DateTime? @map("backfill_started_at") @db.DateTime(3)
  backfillCompletedAt     DateTime? @map("backfill_completed_at") @db.DateTime(3)
  priorityCheckedAt       DateTime? @map("priority_checked_at") @db.DateTime(3)
  universeCheckedAt       DateTime? @map("universe_checked_at") @db.DateTime(3)
  lastReceiptCheckedAt    DateTime? @map("last_receipt_checked_at") @db.DateTime(3)
  lastError               String?   @map("last_error") @db.VarChar(1000)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  security                Security  @relation(fields: [securityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([backfillStartedAt, backfillCompletedAt], map: "dart_security_backfill_queue_idx")
  @@index([priorityCheckedAt])
  @@index([universeCheckedAt])
  @@map("dart_security_state")
}

model DartBackfillTask {
  diagnostics Json?
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  securityId     BigInt          @map("security_id") @db.UnsignedBigInt
  fiscalYear     Int             @map("fiscal_year") @db.UnsignedSmallInt
  reportCode     String          @map("report_code") @db.Char(5)
  periodType     FinancialPeriodType @map("period_type")
  status         DartTaskStatus  @default(PENDING)
  attempts       Int             @default(0) @db.UnsignedSmallInt
  selectedReceiptNo String?      @map("selected_receipt_no") @db.Char(14)
  lastAttemptAt  DateTime?       @map("last_attempt_at") @db.DateTime(3)
  nextAttemptAt  DateTime?       @map("next_attempt_at") @db.DateTime(3)
  processedAt    DateTime?       @map("processed_at") @db.DateTime(3)
  errorCode      String?         @map("error_code") @db.VarChar(64)
  errorMessage   String?         @map("error_message") @db.VarChar(1000)
  createdAt      DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  security       Security        @relation(fields: [securityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([securityId, fiscalYear, reportCode])
  @@index([status, fiscalYear, securityId])
  @@index([securityId, status, fiscalYear])
  @@map("dart_backfill_tasks")
}

model DartCollectorState {
  id                    Int      @id @default(1) @db.UnsignedTinyInt
  phase                 String   @default("BACKFILL") @db.VarChar(20)
  backfillStartYear     Int      @default(2015) @map("backfill_start_year") @db.UnsignedSmallInt
  backfillEndYear       Int?     @map("backfill_end_year") @db.UnsignedSmallInt
  backfillInitializedAt DateTime? @map("backfill_initialized_at") @db.DateTime(3)
  corpCodeSyncedAt      DateTime? @map("corp_code_synced_at") @db.DateTime(3)
  backfillCompletedAt   DateTime? @map("backfill_completed_at") @db.DateTime(3)
  phase2StartedAt       DateTime? @map("phase2_started_at") @db.DateTime(3)
  lastRunAt             DateTime? @map("last_run_at") @db.DateTime(3)
  lastError             String?  @map("last_error") @db.VarChar(1000)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("dart_collector_state")
}

model DartApiDailyUsage {
  usageDate          DateTime @id @map("usage_date") @db.Date
  apiCallCount       Int      @default(0) @map("api_call_count") @db.UnsignedInt
  companyCheckCount  Int      @default(0) @map("company_check_count") @db.UnsignedInt
  noDataCount        Int      @default(0) @map("no_data_count") @db.UnsignedInt
  errorCount         Int      @default(0) @map("error_count") @db.UnsignedInt
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("dart_api_daily_usage")
}

model DartDailyCompanyCheck {
  usageDate   DateTime @map("usage_date") @db.Date
  securityId  BigInt   @map("security_id") @db.UnsignedBigInt
  phase       String   @db.VarChar(20)
  checkedAt   DateTime @default(now()) @map("checked_at") @db.DateTime(3)
  security    Security @relation(fields: [securityId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([usageDate, securityId])
  @@index([usageDate, phase])
  @@map("dart_daily_company_checks")
}

model DartFinancialFiling {
  collectionSymbol String? @map("collection_symbol") @db.VarChar(20)
  sourceValidation Json? @map("source_validation")
  normalizationVersion Int @default(1) @map("normalization_version")
  id                     BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  securityId             BigInt              @map("security_id") @db.UnsignedBigInt
  fiscalYear             Int                 @map("fiscal_year") @db.UnsignedSmallInt
  periodType             FinancialPeriodType @map("period_type")
  reportCode             String              @map("report_code") @db.Char(5)
  fsDivision             String              @map("fs_division") @db.Char(3)
  receiptNo              String              @unique @map("receipt_no") @db.Char(14)
  supersedesReceiptNo    String?             @map("supersedes_receipt_no") @db.Char(14)
  reportName             String              @map("report_name") @db.VarChar(300)
  periodEndDate          DateTime            @map("period_end_date") @db.Date
  receiptDate            DateTime            @map("receipt_date") @db.Date
  collectedAt            DateTime            @map("collected_at") @db.DateTime(3)
  source                 String              @default("OPEN_DART") @db.VarChar(30)
  isWithdrawn            Boolean             @default(false) @map("is_withdrawn")
  revenueQuarter         Decimal?            @map("revenue_quarter") @db.Decimal(65, 30)
  revenueYtd             Decimal?            @map("revenue_ytd") @db.Decimal(65, 30)
  operatingProfitQuarter Decimal?            @map("operating_profit_quarter") @db.Decimal(65, 30)
  operatingProfitYtd     Decimal?            @map("operating_profit_ytd") @db.Decimal(65, 30)
  netIncomeQuarter       Decimal?            @map("net_income_quarter") @db.Decimal(65, 30)
  netIncomeYtd           Decimal?            @map("net_income_ytd") @db.Decimal(65, 30)
  totalAssets            Decimal?            @map("total_assets") @db.Decimal(65, 30)
  totalLiabilities       Decimal?            @map("total_liabilities") @db.Decimal(65, 30)
  totalEquity            Decimal?            @map("total_equity") @db.Decimal(65, 30)
  operatingCashFlowQuarter Decimal?           @map("operating_cash_flow_quarter") @db.Decimal(65, 30)
  operatingCashFlowYtd    Decimal?           @map("operating_cash_flow_ytd") @db.Decimal(65, 30)
  capitalExpenditureQuarter Decimal?         @map("capital_expenditure_quarter") @db.Decimal(65, 30)
  capitalExpenditureYtd  Decimal?            @map("capital_expenditure_ytd") @db.Decimal(65, 30)
  accountSources         Json?               @map("account_sources")
  security               Security            @relation(fields: [securityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([securityId, fiscalYear, periodType, receiptDate], map: "dart_filing_company_period_idx")
  @@index([securityId,fiscalYear,periodType,isWithdrawn,receiptDate,collectedAt,receiptNo], map: "dart_filing_latest_idx")
  @@index([fiscalYear, periodType])
  @@map("dart_financial_filings")
}

model WatchlistItem {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  securityId     BigInt        @unique @map("security_id") @db.UnsignedBigInt
  listType       WatchlistType @default(WATCHLIST) @map("list_type")
  targetBuyPrice Decimal?      @map("target_buy_price") @db.Decimal(19, 4)
  priority       Int           @default(0) @db.UnsignedSmallInt
  memo           String?       @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  security       Security      @relation(fields: [securityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([listType, priority])
  @@map("watchlist_items")
}

// User classifications are account scoped. Legacy WatchlistItem is retained as a migration backup.
model AccountWatchlistItem {
  id             BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  accountId      BigInt        @map("account_id") @db.UnsignedBigInt
  securityId     BigInt        @map("security_id") @db.UnsignedBigInt
  listType       WatchlistType @default(WATCHLIST) @map("list_type")
  targetBuyPrice Decimal?      @map("target_buy_price") @db.Decimal(19, 4)
  priority       Int           @default(0) @db.UnsignedSmallInt
  memo           String?       @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  security       Security      @relation(fields: [securityId], references: [id], onDelete: Restrict)

  @@unique([accountId, securityId])
  @@index([securityId])
  @@index([accountId, listType, priority])
  @@map("account_watchlist_items")
}

// A committed request can be replayed without creating a second trade or cash entry.
model TradeRequest {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  accountId    BigInt   @map("account_id") @db.UnsignedBigInt
  requestId    String   @map("request_id") @db.VarChar(64)
  operation    String   @db.VarChar(8)
  requestHash  String   @map("request_hash") @db.Char(64)
  response     Json
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, requestId])
  @@map("trade_requests")
}

model BuyTrade {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  accountId       BigInt           @map("account_id") @db.UnsignedBigInt
  securityId      BigInt           @map("security_id") @db.UnsignedBigInt
  boughtAt        DateTime         @map("bought_at") @db.DateTime(3)
  quantity        Decimal          @db.Decimal(18, 6)
  unitPrice       Decimal          @map("unit_price") @db.Decimal(19, 4)
  memo            String?          @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  account         Account          @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  security        Security         @relation(fields: [securityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sellTrades      SellTrade[]
  cashTransaction CashTransaction?

  @@index([accountId, boughtAt])
  @@index([accountId, securityId, boughtAt])
  @@map("buy_trades")
}

model SellTrade {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  buyTradeId      BigInt           @map("buy_trade_id") @db.UnsignedBigInt
  soldAt          DateTime         @map("sold_at") @db.DateTime(3)
  quantity        Decimal          @db.Decimal(18, 6)
  unitPrice       Decimal          @map("unit_price") @db.Decimal(19, 4)
  memo            String?          @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  buyTrade        BuyTrade         @relation(fields: [buyTradeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cashTransaction CashTransaction?

  @@index([buyTradeId, soldAt])
  @@index([soldAt])
  @@map("sell_trades")
}

model CashTransaction {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  accountId       BigInt              @map("account_id") @db.UnsignedBigInt
  buyTradeId      BigInt?             @unique @map("buy_trade_id") @db.UnsignedBigInt
  sellTradeId     BigInt?             @unique @map("sell_trade_id") @db.UnsignedBigInt
  transactionType CashTransactionType @map("transaction_type")
